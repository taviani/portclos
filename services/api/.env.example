PORT=8080
AUTH_ISSUER=https://auth.example.com
# Local only — never enable in production
AUTH_DISABLED=true
# slog level: debug | info | warn | error
LOG_LEVEL=info
DATABASE_URL=postgres://portclos:portclos@127.0.0.1:5433/portclos?sslmode=disable
# Optional SMTP for house invites (empty host → log only)
# Use the mail hostname (TLS cert), not a raw Docker IP.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Prefer HTTPS landing (Android-friendly), e.g. https://api.example.com/house-invite
HOUSE_INVITE_LINK_BASE=portclos://house-invite
# ANDROID_PACKAGE=com.portclos.app

