 }
 
+func TestNativeReturnTemplateHasOpenLink(t *testing.T) {
+	r, err := New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	rec := httptest.NewRecorder()
+	r.HTMLData(rec, "native_return.html", struct {
+		Title       string
+		RedirectURL template.URL
+		IntentURL   string
+	}{
+		Title:       "Return to app",
+		RedirectURL: template.URL("portclos://auth/callback?code=abc"),
+		IntentURL:   "intent://auth/callback?code=abc#Intent;scheme=portclos;end",
+	})
+	if rec.Code != 200 {
+		t.Fatalf("status %d body %q", rec.Code, rec.Body.String())
+	}
+	body := rec.Body.String()
+	if !strings.Contains(body, "portclos://auth/callback?code=abc") {
+		t.Fatalf("missing redirect: %s", body)
+	}
+	if strings.Contains(body, "ZgotmplZ") {
+		t.Fatalf("custom scheme was sanitized away: %s", body)
+	}
+}
