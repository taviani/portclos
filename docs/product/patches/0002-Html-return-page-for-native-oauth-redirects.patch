diff --git a/internal/adapter/http/handler/native_redirect.go b/internal/adapter/http/handler/native_redirect.go
new file mode 100644
index 0000000..8acb2f7
--- /dev/null
+++ b/internal/adapter/http/handler/native_redirect.go
@@ -0,0 +1,38 @@
+package handler
+
+import (
+	"net/url"
+	"strings"
+)
+
+func isNativeSchemeRedirect(raw string) bool {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme == "" {
+		return false
+	}
+	switch strings.ToLower(u.Scheme) {
+	case "http", "https":
+		return false
+	default:
+		return true
+	}
+}
+
+// androidIntentURL turns a custom-scheme URL into a Chrome-friendly intent://
+// link so Custom Tabs can hand the OAuth redirect back to the app.
+func androidIntentURL(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return raw
+	}
+	host := u.Host
+	path := u.EscapedPath()
+	if path == "" {
+		path = "/"
+	}
+	ssp := host + path
+	if u.RawQuery != "" {
+		ssp += "?" + u.RawQuery
+	}
+	return "intent://" + ssp + "#Intent;scheme=" + u.Scheme + ";end"
+}
diff --git a/internal/adapter/http/handler/native_redirect_test.go b/internal/adapter/http/handler/native_redirect_test.go
new file mode 100644
index 0000000..c703152
--- /dev/null
+++ b/internal/adapter/http/handler/native_redirect_test.go
@@ -0,0 +1,26 @@
+package handler
+
+import "testing"
+
+func TestIsNativeSchemeRedirect(t *testing.T) {
+	if isNativeSchemeRedirect("https://app.example/callback?code=1") {
+		t.Fatal("https should use HTTP redirect")
+	}
+	if isNativeSchemeRedirect("http://localhost:4322/auth/callback") {
+		t.Fatal("http should use HTTP redirect")
+	}
+	if !isNativeSchemeRedirect("portclos://auth/callback?code=1&state=2") {
+		t.Fatal("custom scheme should use the HTML return page")
+	}
+	if isNativeSchemeRedirect("://missing-scheme") {
+		t.Fatal("invalid URL is not a native redirect")
+	}
+}
+
+func TestAndroidIntentURL(t *testing.T) {
+	got := androidIntentURL("portclos://auth/callback?code=abc&state=xyz")
+	want := "intent://auth/callback?code=abc&state=xyz#Intent;scheme=portclos;end"
+	if got != want {
+		t.Fatalf("got %q want %q", got, want)
+	}
+}
