{
  "expo": {
    "name": "Portclos",
    "slug": "portclos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "portclos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.portclos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Portclos utilise la caméra pour les photos de fermeture de maison.",
        "NSPhotoLibraryUsageDescription": "Portclos utilise la photothèque pour les photos de fermeture de maison."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3d7eb5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.portclos.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3d7eb5"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Portclos utilise la caméra pour les photos de fermeture de maison.",
          "photosPermission": "Portclos utilise la photothèque pour les photos de fermeture de maison."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "router": {}
    }
  }
}
