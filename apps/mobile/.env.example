# Copy to apps/mobile/.env (gitignored). Never commit real hosts or tokens.

# =============================================================================
# A) Local API (AUTH_DISABLED) — seed data, Mode local button
# =============================================================================
EXPO_PUBLIC_API_URL=http://localhost:8080
# Placeholder issuer (Mode local does not need a real OIDC host)
EXPO_PUBLIC_AUTH_ISSUER=https://auth.example.com
EXPO_PUBLIC_AUTH_CLIENT_ID=portclos

# =============================================================================
# B) Production values — real houses / login (preferred for UI acceptance)
#    Use the same values as GitHub Secrets / EAS:
#      EXPO_PUBLIC_API_URL, EXPO_PUBLIC_AUTH_ISSUER, EXPO_PUBLIC_AUTH_CLIENT_ID
#    Or: set those as Cursor Secrets, then:
#      npm run env:prod && npm start
#    Mode local is hidden when API is not loopback.
# =============================================================================
# EXPO_PUBLIC_API_URL=https://your-production-api.example
# EXPO_PUBLIC_AUTH_ISSUER=https://your-oidc-issuer.example
# EXPO_PUBLIC_AUTH_CLIENT_ID=portclos

# EAS link — required for `eas build` / `eas submit` (app.config.js).
# Never commit real values. Do not re-run `eas init` (it cannot write app.config.js).
EXPO_OWNER=your-expo-username
EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000
