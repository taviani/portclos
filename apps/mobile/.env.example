# Local defaults for Expo (not used in EAS CI — set secrets there).
EXPO_PUBLIC_API_URL=http://localhost:8080
# OIDC issuer (placeholder — set real value in local .env / EAS secrets only)
EXPO_PUBLIC_AUTH_ISSUER=https://auth.example.com
EXPO_PUBLIC_AUTH_CLIENT_ID=portclos

# EAS link (gitignored — never commit real values; used by app.config.js)
# Copy from a one-time `npx eas-cli@latest init`, then discard app.json changes.
EXPO_OWNER=your-expo-username
EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000
