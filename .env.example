# Copy to .env at the repo root for docker-compose (never commit real .env).

# API
PORT=8080
AUTH_ISSUER=https://auth.example.com
# Local / CI only — must be false (or unset) in production
AUTH_DISABLED=true
# slog level: debug | info | warn | error
LOG_LEVEL=info

# Postgres (compose db + API DATABASE_URL override)
POSTGRES_USER=portclos
POSTGRES_PASSWORD=portclos
POSTGRES_DB=portclos
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8080

# Used when running the API on the host (go run), not inside compose
DATABASE_URL=postgres://portclos:portclos@127.0.0.1:5433/portclos?sslmode=disable
# Closing checklist photo files (host path when running API locally)
UPLOAD_DIR=./data/uploads
