# Copy to .env at the repo root for docker-compose (never commit real .env).

# API
PORT=8080
AUTH_ISSUER=https://auth.example.com
# Local / CI only — must be false (or unset) in production
AUTH_DISABLED=true
# slog level: debug | info | warn | error
LOG_LEVEL=info

# Postgres (compose db + API DATABASE_URL override)
POSTGRES_USER=portclos
POSTGRES_PASSWORD=portclos
POSTGRES_DB=portclos
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8080
# Metabase UI (localhost only — use SSH tunnel on the VPS)
METABASE_HOST_PORT=3000

# Used when running the API on the host (go run), not inside compose
DATABASE_URL=postgres://portclos:portclos@127.0.0.1:5433/portclos?sslmode=disable
# Closing checklist photo files (host path when running API locally)
UPLOAD_DIR=./data/uploads

# House invite mail (optional — without SMTP_HOST, invites are logged only)
# Use the mail hostname (matches TLS cert), not a raw Docker IP like 172.22.1.1.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# Prefer an HTTPS landing page (works from Android email clients); falls back to deep link.
# Example: https://api.example.com/house-invite
HOUSE_INVITE_LINK_BASE=portclos://house-invite
# ANDROID_PACKAGE=com.portclos.app

